# Copier en .env et adapter.

# --- LM Studio ---
# Serveur local OpenAI-compatible (démarré via `lms server start` ou l'onglet Developer)
LMSTUDIO_HOST=http://localhost:1234

# Modèles à benchmarker (clés telles qu'affichées par `lms ls`), séparés par des virgules.
# Choisir des modèles petits et rapides pour tenir le budget temps (cf. README).
MODELS=qwen2.5-3b-instruct,gemma-2-2b-it,llama-3.2-3b-instruct,phi-3.5-mini-instruct

# Alléger le run : échantillon stratifié d'au plus N questions par catégorie
# (tirage déterministe via SEED). Vide/0 = tout le dataset (~5248 q).
# 75 -> ~1680 q ; avec 2 modèles x 2 prompts ~= 6700 appels ~= 2-3 h.
SAMPLE_PER_CAT=75      # NB : donne 1679 questions ; le run publié en a 1784 (figées via --question-ids-from, voir README)

# --- Reproductibilité ---
SEED=42
TEMPERATURE=0
MAX_TOKENS=64
